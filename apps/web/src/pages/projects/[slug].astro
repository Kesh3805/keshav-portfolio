---
import { ArrowLeft, ExternalLink } from '@lucide/astro';
import { render } from 'astro:content';
import KeshavMark from '../../components/brand/KeshavMark.astro';
import MetricValue from '../../components/MetricValue.astro';
import MotionFigure from '../../components/MotionFigure.astro';
import Toc from '../../components/Toc.astro';
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticlesForProject, getProjects, tagSlug, type Project } from '../../lib/content';
import { href } from '../../lib/paths';
import { nodes as topology } from '../../lib/topology';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project, projects } }));
}

interface Props {
  project: Project;
  projects: Project[];
}

const { project, projects } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const related = await getArticlesForProject(data.slug);

const siblings = projects.filter((p) => p.data.category === data.category);
const position = siblings.findIndex((p) => p.id === project.id);
const next = siblings[(position + 1) % siblings.length];
const categoryLabel = data.category === 'professional' ? 'Professional' : 'Personal / Open Source';

// Continuity between case studies: the building blocks this project and the next one share.
const uses = (slug: string) => new Set(topology.filter((n) => n.projects.some((p) => p.slug === slug)).map((n) => n.label));
const shared = next ? [...uses(data.slug)].filter((label) => uses(next.data.slug).has(label)) : [];
---

<BaseLayout title={data.title} description={data.description} ogImage={`projects/${data.slug}`}>
  <script is:inline slot="head">
    // Cross-document view transition: the next-project title morphs into the next page's heading.
    addEventListener('pageswap', (event) => {
      const link = document.querySelector('[data-next-link]');
      if (event.viewTransition && link && event.activation?.entry?.url === link.href) {
        link.querySelector('[data-next-title]').style.viewTransitionName = 'project-title';
      }
    });
    addEventListener('pagereveal', (event) => {
      const from = window.navigation?.activation?.from?.url ?? '';
      if (!event.viewTransition || !from.includes('/projects/')) return;
      const title = document.querySelector('[data-project-title]');
      if (!title) return;
      title.style.viewTransitionName = 'project-title';
      event.viewTransition.finished.finally(() => (title.style.viewTransitionName = ''));
    });
  </script>
  <article class="container-page project">
    <header class="head">
      <a class="back meta" href={href(data.category === 'professional' ? '/work' : '/projects')}>
        <ArrowLeft size={14} aria-hidden="true" />
        {data.category === 'professional' ? 'Work' : 'Projects'}
      </a>
      <p class="category with-mark" data-category={data.category}>
        <KeshavMark size={14} accent={data.category === 'professional'} />{categoryLabel}
      </p>
      <h1 data-project-title>{data.title}</h1>
      <p class="description">{data.description}</p>
    </header>

    {
      data.metrics.length > 0 && (
        <section class="results" aria-labelledby="results-title">
          <h2 class="meta results-title" id="results-title">
            Key results
          </h2>
          <ul class="results-grid">
            {data.metrics.map((metric, i) => (
              <li class:list={['result', { lead: i === 0 }]}>
                <MetricValue value={metric.value} size="lg" />
                <span class="result-label">{metric.label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <aside class="spec" aria-label="Project details">
      <dl>
        {
          data.role && (
            <div>
              <dt class="meta">Role</dt>
              <dd>{data.role}</dd>
            </div>
          )
        }
        {
          data.repository && (
            <div>
              <dt class="meta">Repository</dt>
              <dd>
                <a class="link" href={data.repository} rel="noopener">
                  {data.repository.replace('https://github.com/', '')}
                  <ExternalLink size={12} aria-hidden="true" />
                </a>
              </dd>
            </div>
          )
        }
        {
          data.liveUrl && (
            <div>
              <dt class="meta">Live</dt>
              <dd>
                <a class="link" href={data.liveUrl} rel="noopener">
                  {new URL(data.liveUrl).host}
                  <ExternalLink size={12} aria-hidden="true" />
                </a>
              </dd>
            </div>
          )
        }
        <div class="wide">
          <dt class="meta">Technology</dt>
          <dd>
            <ul class="stack">
              {data.technologies.map((tech) => <li class="tag">{tech}</li>)}
            </ul>
          </dd>
        </div>
        {
          data.tags.length > 0 && (
            <div class="wide">
              <dt class="meta">Topics</dt>
              <dd>
                <ul class="stack">
                  {data.tags.map((tag) => (
                    <li>
                      <a class="tag" href={href(`/tags/${tagSlug(tag)}`)}>
                        #{tag}
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )
        }
      </dl>

    </aside>

    {
      data.motion && (
        <div class="visual">
          <MotionFigure name={data.motion} />
        </div>
      )
    }

    <div class="body">
      <div class="toc-col">
        <div class="toc-sticky">
          <Toc
            headings={headings}
            extra={related.length ? [{ slug: 'related-writing', text: 'Related Writing' }] : []}
          />
        </div>
      </div>
      <div class="content">
        <div class="prose">
          <Content />
        </div>

        {
          related.length > 0 && (
            <section class="related" aria-labelledby="related-writing" data-reveal>
              <h2 class="section-label" id="related-writing">
                Related writing
              </h2>
              <WritingList articles={related} />
            </section>
          )
        }

        {
          next && next.id !== project.id && (
            <nav class="next" aria-label="Next project" data-reveal>
              <span class="meta">
                Next · {categoryLabel}
                {shared.length > 0 && <span class="shared"> · shares {shared.join(', ')}</span>}
              </span>
              <a href={href(`/projects/${next.data.slug}`)} data-next-link>
                <span data-next-title>{next.data.title}</span> →
              </a>
            </nav>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 1fr) 22rem;
      column-gap: 4rem;
    }

    .head {
      grid-column: 1;
    }

    .spec {
      grid-column: 2;
      grid-row: 1 / span 3;
    }

    .results {
      grid-column: 1;
    }

    .visual {
      grid-column: 1;
    }

    .body {
      grid-column: 1 / -1;
    }
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .back:hover {
    color: var(--text);
  }

  /* The mark stands in for the category square: its hub carries the accent for professional work. */
  .with-mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .with-mark::before {
    content: none;
  }

  h1 {
    margin-top: 0.75rem;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: -0.035em;
  }

  .description {
    margin-top: 1rem;
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 40rem;
  }

  .spec {
    align-self: start;
    padding: 1.35rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-raised), var(--surface) 40%);
    box-shadow: var(--bevel), var(--shadow-2);
  }

  .spec dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .spec dt::after {
    content: '';
    flex: 1;
    border-top: 1px dashed var(--line);
  }

  /* Executive metric callouts */
  .results-title {
    margin-bottom: 0.85rem;
  }

  .results-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .result {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.1rem 1.15rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-raised), var(--surface));
    box-shadow: var(--bevel), var(--shadow-1);
    overflow: hidden;
  }

  .result::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1rem;
    bottom: 1rem;
    width: 2px;
    border-radius: 2px;
    background: var(--line-strong);
  }

  .result.lead {
    border-color: color-mix(in srgb, var(--data) 40%, var(--line));
    box-shadow: var(--bevel), var(--shadow-2);
  }

  .result.lead::before {
    background: var(--data);
  }

  .result-label {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .results-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .result {
      padding: 0.85rem 0.8rem 0.8rem;
    }

    .result :global(.lg .result) {
      font-size: 1.2rem;
    }

    .result-label {
      font-size: 0.78rem;
    }
  }

  .spec dl {
    display: grid;
    gap: 1rem;
  }

  .spec dd {
    margin-top: 0.3rem;
    font-size: 0.93rem;
    overflow-wrap: anywhere;
  }

  .spec dd a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .body {
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: 4rem;
    }

    .toc-sticky {
      position: sticky;
      top: 5.5rem;
    }
  }

  @media (max-width: 63.99rem) {
    .toc-col {
      display: none;
    }
  }

  .content {
    min-width: 0;
  }

  .content .prose > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .related {
    margin-top: 4rem;
    max-width: var(--measure);
  }

  .related h2 {
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .next {
    display: grid;
    gap: 0.35rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }

  .next a {
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
  }

  .next a:hover {
    color: var(--accent);
  }
</style>
