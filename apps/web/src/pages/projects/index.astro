---
import SignalTitle from '../../components/SignalTitle.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/content';
import { href } from '../../lib/paths';

const professional = await getProjects('professional');
const personal = await getProjects('personal');
const all = [...professional, ...personal];

// Engineering areas, each a set of taxonomy tags. Counts come from the content.
const filters = [
  { id: 'backend', label: 'Backend & Systems', tags: ['Backend', 'Systems'] },
  { id: 'distributed', label: 'Distributed Systems', tags: ['Distributed Systems'] },
  { id: 'ai', label: 'AI & RAG', tags: ['AI', 'RAG', 'LLM'] },
  { id: 'security', label: 'Security', tags: ['Security'] },
  { id: 'realtime', label: 'Real-Time', tags: ['Real-Time'] },
].map((f) => ({ ...f, count: all.filter((p) => p.data.tags.some((t) => f.tags.includes(t))).length }));
---

<BaseLayout
  title="Projects"
  description="Professional projects from jpteam / C1X Inc. and personal / open-source systems: AI memory, content forensics, health-visit verification and automated code review."
>
  <div class="container-page page">
    <header class="page-head">
      <SignalTitle kicker="Index" text="Projects" />
      <p class="lede">
        Two groups, kept apart on purpose. Professional work was built inside a team at jpteam / C1X
        Inc.; personal projects are my own repositories.
      </p>

      <div class="filters" role="group" aria-label="Filter projects by area" data-filters>
        <button type="button" class="pill" data-filter="all" aria-pressed="true">
          All <span class="n">{all.length}</span>
        </button>
        {
          filters.map((f) => (
            <button type="button" class="pill" data-filter={f.id} data-match={f.tags.join('|')} aria-pressed="false">
              {f.label} <span class="n">{f.count}</span>
            </button>
          ))
        }
      </div>
      <p class="meta showing" aria-hidden="true" data-showing>
        Showing <span class="count" data-shown>{all.length}</span> of {all.length}
      </p>
      <p class="sr-only" role="status" aria-live="polite" data-filter-status></p>
    </header>

    <section aria-labelledby="professional" data-group>
      <SectionHeader index="A" label="Professional" id="professional">
        <a class="link more" href={href('/work')}>Read as work history →</a>
      </SectionHeader>
      <div class="cards" data-stagger>
        {professional.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
      </div>
      <p class="none meta" hidden>No professional projects in this area.</p>
    </section>

    <section aria-labelledby="personal" data-group>
      <SectionHeader index="B" label="Personal / Open Source" id="personal" />
      <div class="cards" data-stagger>
        {personal.map((project, i) => <ProjectCard project={project} index={i + 1} />)}
      </div>
      <p class="none meta" hidden>No personal projects in this area.</p>
    </section>
  </div>
</BaseLayout>

<script>
  import { matchesFilter } from '../../lib/topology-state';

  // Client-side filter; without JS every project is listed and the pills stay hidden.
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  if (bar) {
    const pills = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.cards [data-slug]')];
    const status = document.querySelector<HTMLElement>('[data-filter-status]')!;
    const shownEl = document.querySelector<HTMLElement>('[data-shown]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');


    const apply = (id: string, sync = true) => {
      const pill = pills.find((p) => p.dataset.filter === id) ?? pills[0]!;
      const match = pill.dataset.match?.split('|') ?? null;
      for (const p of pills) p.setAttribute('aria-pressed', String(p === pill));

      let shown = 0;
      for (const card of cards) {
        const visible = matchesFilter(card.dataset.tags?.split('|') ?? [], match);
        card.hidden = !visible;
        if (visible) shown++;
      }
      for (const group of document.querySelectorAll<HTMLElement>('[data-group]')) {
        const any = [...group.querySelectorAll<HTMLElement>('[data-slug]')].some((c) => !c.hidden);
        group.querySelector<HTMLElement>('.none')!.hidden = any;
      }
      status.textContent = `Showing ${shown} of ${cards.length} projects`;
      // m8 — the visible count rolls to its new value.
      if (shownEl.textContent !== String(shown)) {
        shownEl.textContent = String(shown);
        shownEl.classList.remove('tick');
        void shownEl.offsetWidth;
        shownEl.classList.add('tick');
      }

      if (sync) {
        const url = new URL(location.href);
        if (pill.dataset.filter === 'all') url.searchParams.delete('filter');
        else url.searchParams.set('filter', pill.dataset.filter!);
        history.replaceState(null, '', url);
      }
    };

    // M7 — cards glide to their new places: each card is its own transition layer for the
    // length of the change, so moves, arrivals and departures animate instead of jumping.
    const filter = (id: string) => {
      if (!document.startViewTransition || reduced.matches) return apply(id);
      cards.forEach((card) => {
        card.style.viewTransitionName = `card-${card.dataset.slug}`;
        card.style.setProperty('view-transition-class', 'card');
      });
      const vt = document.startViewTransition(() => apply(id));
      vt.finished.finally(() =>
        cards.forEach((card) => {
          card.style.viewTransitionName = '';
          card.style.removeProperty('view-transition-class');
        }),
      );
    };
    for (const pill of pills) pill.addEventListener('click', () => filter(pill.dataset.filter!));
    apply(new URLSearchParams(location.search).get('filter') ?? 'all', false);
  }
</script>

<style>
  .page {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 6vw, 4rem);
  }


  .showing {
    margin-top: 0.9rem;
  }

  /* With JS the filter bar and count are part of the first paint, so revealing them later
     (the script unhides them) never moves the cards below. Without JS they stay hidden. */
  /* The filter bar and count need JS, so they exist only when it runs — decided by the
     html.js class set in <head>, so they are part of the first paint and never shift the
     cards. (Not the hidden attribute: the base reset hides [hidden] with a layered
     !important that no unlayered rule can override.) */
  .filters,
  .showing {
    display: none;
  }

  :global(html.js) .filters {
    display: flex;
  }

  :global(html.js) .showing {
    display: block;
  }

  .count {
    display: inline-block;
    min-width: 1ch;
    color: var(--data);
  }

  @media (prefers-reduced-motion: no-preference) {
    .count.tick {
      animation: count-tick 320ms var(--ease-out);
    }
  }

  @keyframes count-tick {
    from {
      opacity: 0;
      translate: 0 0.6em;
    }
  }

  .lede {
    margin-top: 1rem;
    max-width: 40rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  .filters {
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.75rem;
  }

  .filters[hidden] {
    display: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    color: var(--muted);
    cursor: pointer;
    transition:
      border-color var(--dur-micro) var(--ease),
      color var(--dur-micro) var(--ease),
      background-color var(--dur-micro) var(--ease);
  }

  .pill:hover {
    border-color: var(--line-strong);
    color: var(--text);
  }

  .pill[aria-pressed='true'] {
    border-color: color-mix(in srgb, var(--accent) 60%, var(--line));
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    color: var(--text);
  }

  .n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .more {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: 1rem;
  }

  .cards > :global([hidden]) {
    display: none;
  }

  .cards > :global(:not([hidden])) {
    animation: card-in var(--dur-ui) var(--ease-out);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }

  .none {
    padding: 1.25rem 0;
    text-transform: none;
    letter-spacing: 0;
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
