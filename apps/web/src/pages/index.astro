---
import { getCollection, getEntry, render } from 'astro:content';
import KeshavMark from '../components/brand/KeshavMark.astro';
import IdentityHero from '../components/IdentityHero.astro';
import ScrollRail from '../components/ScrollRail.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RoleTimeline from '../components/RoleTimeline.astro';
import SectionHeader from '../components/SectionHeader.astro';
import MetricValue from '../components/MetricValue.astro';
import SystemDiagram from '../components/SystemDiagram.astro';
import SystemsReel from '../components/SystemsReel.astro';
import WritingList from '../components/WritingList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getExperience, getProjects, getProjectsBySlug } from '../lib/content';
import { downloadName, href, linkHref } from '../lib/paths';
import { site } from '../site.config';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const professional = projects.filter((p) => p.data.category === 'professional');
const personal = projects.filter((p) => p.data.category === 'personal');
const hud = projects.flatMap((project) =>
  project.data.metrics.filter((m) => m.highlight).map((metric) => ({ metric, project })),
);

const [experience] = await getExperience();
const experienceProjects = experience ? await getProjectsBySlug(experience.data.projects) : [];

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const titleOf = new Map(projects.map((p) => [p.data.slug, p.data.title]));
for (const area of areas) {
  for (const slug of area.data.projects) {
    if (!titleOf.has(slug)) throw new Error(`Area "${area.id}" references unknown project "${slug}"`);
  }
}

const articles = await getArticles();
const selectedWriting = [
  ...articles.filter((a) => a.data.featured),
  ...articles.filter((a) => !a.data.featured),
].slice(0, 4);

const now = await getEntry('notes', 'now');
const nowRendered = now ? await render(now) : undefined;
const hasFocus = (nowRendered?.headings.length ?? 0) > 0;
---

<BaseLayout>
  <IdentityHero />
  <ScrollRail stops="main > section[aria-labelledby]" />

  <!-- The exploration: the systems the work runs on, below the identity hero. -->
  <section class="systems grid-backdrop" aria-labelledby="systems-title">
    <!-- M4: where the hero's dropping signal lands, on this section's top rule. -->
    <span class="landing" aria-hidden="true"></span>
    <div class="container-page systems-inner">
      <div class="systems-copy">
        <p class="kicker">
          <KeshavMark size={16} class="kicker-mark" />
          <span>Software Engineer</span>
          <span class="sep" aria-hidden="true">/</span>
          <span>jpteam · C1X Inc.</span>
        </p>
        <h2 id="systems-title">The systems behind the work</h2>
        <p class="lede">
          Production backends for GST compliance, document AI and real-time workflows at work.
          Retrieval gating, content forensics and review tooling on my own time. This site is where
          both get written down.
        </p>
        <!-- One quiet line of ways to reach me. -->
        <ul class="reach" aria-label="Contact">
          {
            site.links.linkedin && (
              <li>
                <a class="link" href={site.links.linkedin} rel="me noopener">LinkedIn</a>
              </li>
            )
          }
          {
            site.links.email && (
              <li>
                <a class="link" href={`mailto:${site.links.email}`}>Email</a>
              </li>
            )
          }
          <li>
            <a class="link" href={site.links.github} rel="me noopener">GitHub</a>
            <span class="count"> · {site.stats[0]?.value} repos</span>
          </li>
          {
            site.links.resume && (
              <li>
                <a
                  class="link"
                  href={linkHref(site.links.resume)}
                  download={downloadName(site.links.resume, 'Keshav_Resume.pdf')}
                >Résumé</a>
              </li>
            )
          }
        </ul>
      </div>
      <div class="hero-visual">
        <SystemDiagram />
      </div>
    </div>

    <div class="container-page">
      <SystemsReel />
    </div>

    {
      hud.length > 0 && (
        <div class="container-page hud-wrap">
          <p class="meta hud-caption">
            Figures from the work · {professional.length} professional + {personal.length} personal
            projects
          </p>
          <ul class="hud">
            {hud.map(({ metric, project }) => (
              <li class="hud-card">
                <MetricValue value={metric.value} />
                <span class="hud-label">{metric.label}</span>
                <a class="hud-source" href={href(`/projects/${project.data.slug}`)}>
                  {project.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="container-page block" aria-labelledby="selected-work" data-reveal>
    <SectionHeader index="01" label="Selected work" id="selected-work">
      <a class="link more" href={href('/projects')}>All projects →</a>
    </SectionHeader>
    <p class="intro">
      Chosen because each shows a different kind of problem — not a ranking.
    </p>
    <div class="cards" data-stagger>
      {featured.map((project, i) => <ProjectCard project={project} index={i + 1} preview />)}
    </div>
  </section>

  <section class="container-page block" aria-labelledby="areas" data-reveal>
    <SectionHeader index="02" label="Engineering areas" id="areas" />
    <ol class="areas">
      {
        areas.map((area, i) => (
          <li>
            <span class="meta area-index">{`0${i + 1}`}</span>
            <div>
              <h3>{area.data.title}</h3>
              <p>{area.data.summary}</p>
              <p class="area-links meta">
                {area.data.projects.map((slug) => (
                  <a class="link" href={href(`/projects/${slug}`)}>
                    {titleOf.get(slug)}
                  </a>
                ))}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    experience && (
      <section class="container-page block" aria-labelledby="experience" data-reveal>
        <SectionHeader index="03" label="Experience" id="experience">
          <a class="link more" href={href('/work')}>Work in detail →</a>
        </SectionHeader>
        <div class="experience">
          <div>
            <p class="meta">
              {experience.data.employmentType}
              {experience.data.period && <span class="period"> · {experience.data.period}</span>}
            </p>
            <h3>{experience.data.role}</h3>
            <p class="company">{experience.data.company}</p>
            <RoleTimeline timeline={experience.data.timeline} />
          </div>
          <div>
            <p class="experience-desc">{experience.data.description}</p>
            <ul class="experience-projects">
              {experienceProjects.map((project) => (
                <li>
                  <a href={href(`/work#${project.data.slug}`)}>
                    <span>{project.data.title}</span>
                    <span class="meta">{project.data.role?.split('·')[0]?.trim()}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {
    selectedWriting.length > 0 && (
      <section class="container-page block" aria-labelledby="writing" data-reveal>
        <SectionHeader index="04" label="Selected writing" id="writing">
          <a class="link more" href={href('/writing')}>All writing →</a>
        </SectionHeader>
        <WritingList articles={selectedWriting} />
      </section>
    )
  }

  {
    hasFocus && nowRendered && (
      <section class="container-page block" aria-labelledby="focus" data-reveal>
        <SectionHeader index="05" label="Current focus" id="focus">
          <a class="link more" href={href('/now')}>/now →</a>
        </SectionHeader>
        <div class="prose focus">
          <nowRendered.Content />
        </div>
      </section>
    )
  }

  <section class="container-page block" aria-labelledby="contact" data-reveal>
    <SectionHeader index={hasFocus ? '06' : '05'} label="GitHub / Contact" id="contact" />
    <div class="contact">
      <p>
        Code for the personal projects is public on GitHub. Professional work happened in employer
        repositories; this site describes what I built there.
      </p>
      <ul>
        <li>
          <a class="btn" href={site.links.github} rel="me noopener">GitHub · Kesh3805</a>
        </li>
        {
          site.links.linkedin && (
            <li>
              <a class="btn" href={site.links.linkedin} rel="me noopener">LinkedIn</a>
            </li>
          )
        }
        {
          site.links.email && (
            <li>
              <a class="btn" href={`mailto:${site.links.email}`} title={`Send email to ${site.links.email} (copies on click)`}>
                Email · {site.links.email}
              </a>
            </li>
          )
        }
        {
          site.links.resume && (
            <li>
              <a
                class="btn"
                href={linkHref(site.links.resume)}
                download={downloadName(site.links.resume, 'Keshav_Resume.pdf')}
              >
                Résumé
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .landing {
    display: none;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* The same x as the hero's accent node: the stage's width and centring, repeated. */
      .landing {
        --sw: min(100%, calc((100svh - 4.75rem) * 4 / 5));
        --at: 0.9259;
        display: block;
        position: absolute;
        top: 0;
        left: calc(50% - var(--sw) / 2 + var(--sw) * var(--at));
        width: 9px;
        height: 9px;
        margin: -4.5px 0 0 -4.5px;
        background: var(--data);
        rotate: 45deg;
        z-index: 1;
        /* Longhands, and not all of them: the minifier would otherwise fold the timeline into the
           animation shorthand, where it is not allowed, and the browser would drop the rule. */
        animation-name: land;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --identity;
        animation-range: exit 38% exit 52%;
      }

      @media (min-width: 56.25rem) {
        .landing {
          --sw: min(100%, calc((100svh - 4.75rem) * 16 / 9));
          --at: 0.9167;
        }
      }
    }
  }

  @keyframes land {
    from {
      scale: 0;
      opacity: 0;
    }
  }

  .systems {
    position: relative;
    border-block: 1px solid var(--line);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .systems-inner {
    display: grid;
    gap: 3rem;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .systems-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    }
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.5rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-raised);
    box-shadow: var(--bevel), var(--shadow-1);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .sep {
    color: var(--faint);
  }

  .systems :global(.kicker-mark) {
    color: var(--text);
  }


  .systems h2 {
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    font-weight: 600;
    letter-spacing: -0.042em;
    line-height: 1.02;
    max-width: 17ch;
  }

  .lede {
    margin-top: 1.6rem;
    max-width: 36rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* Secondary line: ways to reach me, set in the metadata voice. */
  .reach {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .reach li + li::before {
    content: '·';
    margin-inline: 0.6rem;
    color: var(--faint);
  }

  .reach a:hover {
    color: var(--text);
  }

  .count {
    color: var(--faint);
  }

  .hero-visual {
    max-width: 38rem;
    width: 100%;
    justify-self: center;
  }

  .hud-caption {
    margin-bottom: 0.9rem;
  }

  .hud {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .hud-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.05rem 1.1rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface-raised), var(--surface));
    box-shadow: var(--bevel), var(--shadow-2);
    overflow: hidden;
  }

  /* HUD corner ticks and a luminous top rule. */
  .hud-card::before {
    content: '';
    position: absolute;
    inset: 0 1.1rem auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--data), transparent);
    opacity: 0.55;
  }

  .hud-card::after {
    content: '';
    position: absolute;
    inset: 6px;
    pointer-events: none;
    background:
      linear-gradient(var(--line-strong), var(--line-strong)) top left / 8px 1px,
      linear-gradient(var(--line-strong), var(--line-strong)) top left / 1px 8px,
      linear-gradient(var(--line-strong), var(--line-strong)) bottom right / 8px 1px,
      linear-gradient(var(--line-strong), var(--line-strong)) bottom right / 1px 8px;
    background-repeat: no-repeat;
  }

  .hud-label {
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .hud-source {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--faint);
    text-decoration: none;
    width: fit-content;
  }

  .hud-source::before {
    content: '↳ ';
  }

  .hud-source:hover {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .hud {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .hud-card {
      padding: 0.85rem 0.8rem 0.8rem;
    }

    .hud-card :global(.md .result) {
      font-size: 1.12rem;
    }

    .hud-label {
      font-size: 0.78rem;
    }

    .hud-source {
      font-size: 0.62rem;
    }
  }

  .block {
    margin-top: clamp(4rem, 9vw, 6.5rem);
  }

  .more {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .intro {
    color: var(--muted);
    margin: -0.75rem 0 1.5rem;
  }

  .cards {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .areas {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .areas li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .areas li > div {
      display: grid;
      grid-template-columns: 16rem minmax(0, 1fr) 14rem;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .area-index {
    padding-top: 0.2rem;
  }

  .areas h3 {
    font-size: 1.05rem;
  }

  .areas p {
    color: var(--muted);
    margin-top: 0.35rem;
  }

  .area-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    text-transform: none;
    letter-spacing: 0;
  }

  .experience {
    display: grid;
    gap: 1.5rem 3rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  @media (min-width: 52rem) {
    .experience {
      grid-template-columns: 16rem minmax(0, 1fr);
    }
  }

  .experience h3 {
    font-size: 1.35rem;
    margin-top: 0.4rem;
  }

  .company {
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .experience-desc {
    color: var(--muted);
    max-width: 44rem;
  }

  .experience-projects {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 40rem) {
    .experience-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .experience-projects a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--dur-micro) var(--ease);
  }

  .experience-projects a:hover {
    border-color: var(--accent);
  }

  .contact {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .contact p {
    color: var(--muted);
  }

  .contact ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
