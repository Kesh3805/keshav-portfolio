---
import SignalTitle from '../../components/SignalTitle.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WritingList from '../../components/WritingList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, getProjects, tagSlug, type Article, type Project } from '../../lib/content';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const [projects, articles] = await Promise.all([getProjects(), getArticles()]);
  const tags = new Set([...projects, ...articles].flatMap((entry) => entry.data.tags));
  return [...tags].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: {
      tag,
      projects: projects.filter((p) => p.data.tags.includes(tag)),
      articles: articles.filter((a) => a.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  projects: Project[];
  articles: Article[];
}

const { tag, projects, articles } = Astro.props;
---

<BaseLayout
  title={`#${tag}`}
  description={`Projects and writing tagged ${tag}: ${projects.length} project${projects.length === 1 ? '' : 's'}, ${articles.length} article${articles.length === 1 ? '' : 's'}.`}
>
  <div class="container-page page">
    <header>
      <p class="meta"><a class="link" href={href('/writing')}>Writing</a> / topic</p>
      <SignalTitle text={`#${tag}`} class="mono-title" />
    </header>

    {
      articles.length > 0 && (
        <section aria-labelledby="tag-writing">
          <h2 class="section-label" id="tag-writing">
            Writing · {articles.length}
          </h2>
          <WritingList articles={articles} />
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section aria-labelledby="tag-projects">
          <h2 class="section-label" id="tag-projects">
            Projects · {projects.length}
          </h2>
          <div class="cards" data-stagger>
            {projects.map((project) => <ProjectCard project={project} />)}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 3rem;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  .page :global(.mono-title) {
    --title-size: clamp(2rem, 5vw, 3rem);
    --title-tracking: 0;
  }

  .page :global(.mono-title .title) {
    font-family: var(--font-mono);
    font-weight: 500;
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(2rem, 5vw, 3rem);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  section h2 {
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .cards {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
