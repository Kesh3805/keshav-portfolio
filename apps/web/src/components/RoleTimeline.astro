---
// Progression at one employer, oldest → newest: "Intern (Aug 2025 — Apr 2026) → Software Engineer (May 2026 — Present)".
// Renders nothing for a single role.
interface Entry {
  role: string;
  employmentType: string;
  period: string;
}

interface Props {
  timeline: Entry[];
}

const steps = [...Astro.props.timeline].reverse();
---

{
  steps.length > 1 && (
    <ol class="trail" aria-label="Role progression" data-reveal>
      {steps.map((step, i) => (
        <li class:list={{ current: i === steps.length - 1 }} style={`--i:${i}`}>
          <span class="role">{step.role}</span>
          <span class="period">
            {step.employmentType} · {step.period}
          </span>
        </li>
      ))}
    </ol>
  )
}

<style>
  .trail {
    position: relative;
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
    padding-left: 0.9rem;
  }

  /* The rail: a line drawn from the first role to the current one. */
  .trail::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--line-strong);
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .trail:not(:global(.is-revealed))::before {
      transform: scaleY(0);
    }

    .trail::before {
      transition: transform 700ms linear 120ms;
    }

    :global(.js) .trail:not(:global(.is-revealed)) li {
      opacity: 0;
      translate: -6px 0;
    }

    li {
      transition:
        opacity var(--dur-ui) var(--ease-out),
        translate var(--dur-ui) var(--ease-out);
      transition-delay: calc(200ms + var(--i) * 320ms);
    }

    :global(.js) .trail:not(:global(.is-revealed)) li::before {
      scale: 0;
    }

    li::before {
      transition: scale var(--dur-ui) var(--ease-out);
      transition-delay: calc(260ms + var(--i) * 320ms);
    }
  }

  li {
    position: relative;
    display: grid;
    gap: 0.1rem;
  }

  /* A node on the rail; the current role is the lit one. */
  li::before {
    content: '';
    position: absolute;
    left: calc(-0.9rem - 4px);
    top: 0.45rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--line-strong);
  }

  li.current::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .role {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .current .role {
    color: var(--text);
    font-weight: 500;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--faint);
  }
</style>
