---
import { downloadName, href, linkHref } from '../lib/paths';
import { site } from '../site.config';
import KeshavMark from './brand/KeshavMark.astro';
---

<footer class="site-footer" data-reveal>
  <div class="container-page inner">
    <p class="meta sign">
      <!-- M9: the signal comes home — the mark resolves once when the footer is reached. -->
      <a class="home" href={href('/')} aria-label={`${site.name} — home`}>
        <KeshavMark size={20} state="resolve" />
      </a>
      <span>Static HTML · Astro · GitHub Pages · no trackers</span>
    </p>
    <ul class="links">
      <li><a class="link" href={href('/now')}>Now</a></li>
      <li><a class="link" href={href('/rss.xml')}>RSS</a></li>
      <li><a class="link" href={site.links.github} rel="me noopener">GitHub</a></li>
      {site.links.linkedin && <li><a class="link" href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>}
      {site.links.email && <li><a class="link" href={`mailto:${site.links.email}`}>Email</a></li>}
      {
        site.links.resume && (
          <li>
            <a
              class="link"
              href={linkHref(site.links.resume)}
              download={downloadName(site.links.resume, 'Keshav_Resume.pdf')}
            >
              Résumé
            </a>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    border-top: 1px solid var(--line);
  }

  .sign {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .home {
    display: inline-flex;
    color: var(--text);
  }

  /* The mark's resolve waits (held on its first frame) until the footer is revealed. */
  :global(.js) .site-footer:not(:global(.is-revealed)) .home :global(*) {
    animation-play-state: paused;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 2.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
