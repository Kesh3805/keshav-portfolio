---
// M5 — the scroll signal rail: a hairline ruler in the left margin with the site's signal
// riding it as the page scrolls, and a tick for each section. The node's position is a
// scroll-driven CSS animation (no scroll listener); ticks are measured once and again on
// resize. Decorative (aria-hidden), wide screens only, and absent under reduced motion or
// where scroll-driven animations are unsupported.
interface Props {
  /** Elements that get a tick: section headings or sections. */
  stops: string;
}

const { stops } = Astro.props;
---

<div class="rail" aria-hidden="true" data-rail={stops}>
  <span class="track"></span>
  <span class="ticks" data-rail-ticks></span>
  <span class="node"></span>
</div>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail && getComputedStyle(rail).display !== 'none') {
    const ticks = rail.querySelector<HTMLElement>('[data-rail-ticks]')!;
    const stops = [...document.querySelectorAll<HTMLElement>(rail.dataset.rail!)];

    const measure = () => {
      const range = document.documentElement.scrollHeight - innerHeight;
      if (range <= 0) return;
      ticks.replaceChildren(
        ...stops.map((el) => {
          const tick = document.createElement('span');
          const at = Math.min(1, Math.max(0, (el.getBoundingClientRect().top + scrollY - innerHeight * 0.35) / range));
          tick.style.top = `${(at * 100).toFixed(2)}%`;
          return tick;
        }),
      );
    };

    // A tick lights once its section has passed the reading line (35% down the viewport).
    const io = new IntersectionObserver(
      () => {
        const line = innerHeight * 0.35;
        stops.forEach((el, i) => ticks.children[i]?.classList.toggle('passed', el.getBoundingClientRect().top < line));
      },
      { rootMargin: '0px 0px -65% 0px' },
    );

    measure();
    stops.forEach((el) => io.observe(el));
    new ResizeObserver(measure).observe(document.body);
  }
</script>

<style>
  .rail {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 92rem) {
      .rail {
        --h: 52vh;
        display: block;
        position: fixed;
        z-index: 5;
        top: 24vh;
        left: max(1.25rem, calc((100vw - var(--page)) / 2 - 1.5rem));
        width: 12px;
        height: var(--h);
        pointer-events: none;
      }

      .track {
        position: absolute;
        inset: 0 auto 0 50%;
        width: 1px;
        background: var(--line);
      }

      .ticks :global(span) {
        position: absolute;
        left: 50%;
        width: 7px;
        height: 1px;
        margin-left: -3px;
        background: var(--line-strong);
        transition: background-color var(--dur-ui) var(--ease-ui);
      }

      .ticks :global(span.passed) {
        background: var(--data);
      }

      .node {
        position: absolute;
        top: 0;
        left: 50%;
        width: 9px;
        height: 9px;
        margin: -4.5px 0 0 -4.5px;
        background: var(--accent);
        rotate: 45deg;
        /* Longhands, and not all of them: the minifier would otherwise fold the timeline into the
           animation shorthand, where it is not allowed, and the browser would drop the rule. */
        animation-name: rail-ride;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes rail-ride {
    to {
      translate: 0 var(--h);
    }
  }
</style>
