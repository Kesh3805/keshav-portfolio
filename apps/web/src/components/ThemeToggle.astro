---
import { Moon, Sun } from '@lucide/astro';
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to light theme">
  <Sun class="icon-sun" size={16} aria-hidden="true" />
  <Moon class="icon-moon" size={16} aria-hidden="true" />
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const WIPE_MS = 450;

  const label = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    label();
    document.dispatchEvent(new CustomEvent('themechange', { detail: theme }));
  };

  label();

  // The new theme spreads outward from the toggle as a circle (View Transitions API).
  // Without support, or with reduced motion, the theme switches at once.
  let current: ViewTransition | null = null;
  // The theme a click is heading to; the DOM lags behind it while a wipe captures the old frame.
  let target = root.dataset.theme as 'light' | 'dark';
  let pending = 0;
  const settle = () => {
    if (--pending <= 0) {
      pending = 0;
      current = null;
      root.classList.remove('theme-transitioning');
    }
  };

  const switchTheme = (theme: 'light' | 'dark') => {
    target = theme;
    if (!button || !document.startViewTransition || reduced.matches) {
      apply(theme);
      return;
    }
    current?.skipTransition(); // a second click finishes the first wipe instead of queueing
    const rect = button.getBoundingClientRect();
    const x = rect.left + rect.width / 2;
    const y = rect.top + rect.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

    pending++;
    root.classList.add('theme-transitioning');
    // Synchronous on purpose: rendering (and so requestAnimationFrame) is paused until this
    // returns. Listeners that repaint in a frame, like the WebGL topology, still do so before
    // the new state is captured.
    const transition = document.startViewTransition(() => apply(theme));
    current = transition;
    transition.ready
      .then(() => {
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          {
            duration: WIPE_MS,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      })
      .catch(() => {});
    transition.finished.then(settle, settle);
  };

  button?.addEventListener('click', () => {
    const next = target === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    switchTheme(next);
  });

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {
      /* ignore */
    }
    if (stored) return;
    target = event.matches ? 'light' : 'dark';
    apply(target);
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease),
      transform 360ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  /* Pressed: a short compression, released with a spring overshoot. */
  .theme-toggle:active {
    transform: scale(0.92);
    transition-duration: 90ms;
  }

  /* Both icons share one cell; the inactive one rotates away and shrinks. */
  .theme-toggle :global(svg) {
    grid-area: 1 / 1;
    transition:
      transform 320ms var(--ease-out),
      opacity 240ms var(--ease-ui);
  }

  :global([data-theme='light']) .icon-sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.2);
  }

  :global([data-theme='dark']) .icon-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.2);
  }
</style>
