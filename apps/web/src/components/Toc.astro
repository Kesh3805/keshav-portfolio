---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  extra?: { slug: string; text: string }[];
}

const { headings, extra = [] } = Astro.props;
const items = [...headings.filter((h) => h.depth === 2), ...extra];
---

{
  items.length > 1 && (
    <nav class="toc" aria-label="On this page">
      <p class="meta">On this page</p>
      <ol>
        <li class="marker" aria-hidden="true" />
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`}>{item.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script>
  // Scroll-spy: the active entry is the last heading that has passed the top 35% of the viewport.
  // The observer only fires as headings cross that line, so there is no scroll listener.
  const toc = document.querySelector<HTMLElement>('.toc');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const targets = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);

    const update = () => {
      const line = innerHeight * 0.35;
      let current = 0;
      targets.forEach((el, i) => {
        if (el.getBoundingClientRect().top < line) current = i;
      });
      links.forEach((a, i) => {
        const on = i === current;
        a.classList.toggle('active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      // The marker glides to the active entry instead of jumping between links.
      const active = links[current];
      if (marker && active) {
        marker.style.translate = `0 ${active.offsetTop}px`;
        marker.style.height = `${active.offsetHeight}px`;
      }
    };
    const marker = toc.querySelector<HTMLElement>('.marker');

    const io = new IntersectionObserver(update, { rootMargin: '0px 0px -65% 0px', threshold: 0 });
    targets.forEach((el) => io.observe(el));
    update();
  }
</script>

<style>
  .toc a.active {
    color: var(--text);
    font-weight: 500;
  }

  .toc ol {
    position: relative;
    margin-top: 0.75rem;
    display: grid;
    gap: 0.1rem;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.85rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.87rem;
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .toc a:hover {
    color: var(--text);
    border-left-color: var(--line-strong);
  }

  /* One accent marker on the rail, moved to the active entry. */
  .marker {
    position: absolute;
    top: 0;
    left: -1px;
    width: 2px;
    height: 0;
    background: var(--accent);
    border-radius: 1px;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marker {
      transition:
        translate var(--dur-ui) var(--ease-out),
        height var(--dur-ui) var(--ease-out);
    }
  }
</style>
