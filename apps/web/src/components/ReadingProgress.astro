---
// A 2px accent rule at the top of the viewport that fills as the reader moves
// through the element matching `target`. Transform-only, so it never shifts layout.
interface Props {
  target: string;
}

const { target } = Astro.props;
---

<div class="reading-progress" aria-hidden="true" data-progress={target}></div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = bar && document.querySelector<HTMLElement>(bar.dataset.progress!);
  if (bar && article) {
    let start = 0;
    let span = 1;
    // Layout is read only when sizes change (fonts, diagrams, images), never inside the scroll handler.
    const measure = () => {
      const top = article.getBoundingClientRect().top + scrollY;
      start = top;
      span = Math.max(1, article.offsetHeight - innerHeight);
      paint();
    };
    const paint = () => {
      const progress = Math.min(1, Math.max(0, (scrollY - start) / span));
      bar.style.transform = `scaleX(${progress})`;
    };
    new ResizeObserver(measure).observe(article);
    addEventListener('resize', measure, { passive: true });
    addEventListener('scroll', paint, { passive: true });
    measure();
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
</style>
