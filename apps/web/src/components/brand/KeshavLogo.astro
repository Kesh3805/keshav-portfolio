---
// Lockups of the mark and the wordmark. The mark is sized in em so a lockup scales with
// the font size of wherever it is placed.
//   mark · wordmark · horizontal (mark left) · stacked (mark above) · animated (the mark
//   resolving once, then the wordmark)
import type { MarkState } from '../../lib/brand';
import KeshavMark from './KeshavMark.astro';
import KeshavWordmark from './KeshavWordmark.astro';

interface Props {
  variant?: 'mark' | 'wordmark' | 'horizontal' | 'stacked' | 'animated';
  state?: MarkState;
  accent?: boolean;
  /** Use the closed-gap mark (for lockups rendered at 16–24px). */
  small?: boolean;
  caps?: boolean;
  /** Accessible name for the whole lockup; without one it is decorative. */
  label?: string;
  class?: string;
}

const {
  variant = 'horizontal',
  accent = true,
  small,
  caps,
  label,
  class: className,
} = Astro.props;
const state = variant === 'animated' ? 'resolve' : (Astro.props.state ?? 'static');
const markSize = variant === 'stacked' ? '2.6em' : '1.45em';
---

<span
  class:list={['keshav-logo', `v-${variant}`, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {variant !== 'wordmark' && <KeshavMark size={markSize} state={state} accent={accent} small={small} />}
  {variant !== 'mark' && <KeshavWordmark caps={caps} />}
</span>

<style>
  .keshav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: inherit;
  }

  .v-stacked {
    flex-direction: column;
    gap: 0.5em;
  }

  /* The name follows the mark once it has resolved. */
  @media (prefers-reduced-motion: no-preference) {
    .v-animated :global(.keshav-wordmark) {
      animation: logo-name var(--dur-ui) var(--ease-out) 1.1s both;
    }
  }

  @keyframes logo-name {
    from {
      opacity: 0;
      translate: -0.25em 0;
    }
  }
</style>
