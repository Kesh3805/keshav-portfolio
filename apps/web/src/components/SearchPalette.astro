---
// Command palette: ⌘K / Ctrl+K or "/" from anywhere. It fetches the same
// build-time index as /search, and only on first open. Without JS the header
// search button is a plain link to /search.
import { href } from '../lib/paths';
import { nav } from '../site.config';

const jumps = nav.map((item) => ({ label: item.label, url: href(item.path) }));
---

<dialog class="palette" data-palette data-index={href('/search.json')} aria-label="Search the site">
  <form method="dialog" class="field" role="search">
    <input
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search projects, writing, tags…"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
      aria-label="Search"
      data-palette-input
    />
    <kbd>esc</kbd>
  </form>
  <p class="meta group" data-palette-group>Jump to</p>
  <ul id="palette-results" role="listbox" aria-label="Results" data-palette-results></ul>
  <p class="meta empty" data-palette-empty hidden>No matches. Try a technology, like “redis” or “SSE”.</p>
  <footer class="meta">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> open</span>
    <a class="link" href={href('/search')} data-palette-full>Full search</a>
  </footer>
  <script type="application/json" data-palette-jumps set:html={JSON.stringify(jumps)} />
</dialog>

<script>
  import { kindLabel, loadIndex, rank } from '../lib/search';

  const dialog = document.querySelector<HTMLDialogElement>('[data-palette]');
  if (dialog) init(dialog);

  function init(dialog: HTMLDialogElement) {
    const input = dialog.querySelector<HTMLInputElement>('[data-palette-input]')!;
    const list = dialog.querySelector<HTMLUListElement>('[data-palette-results]')!;
    const group = dialog.querySelector<HTMLElement>('[data-palette-group]')!;
    const empty = dialog.querySelector<HTMLElement>('[data-palette-empty]')!;
    const full = dialog.querySelector<HTMLAnchorElement>('[data-palette-full]')!;
    const jumps = JSON.parse(dialog.querySelector('[data-palette-jumps]')!.textContent!) as {
      label: string;
      url: string;
    }[];
    let items: { url: string; title: string; kind: string }[] = [];
    let active = 0;

    const paint = () => {
      list.replaceChildren(
        ...items.map((item, i) => {
          const li = document.createElement('li');
          li.id = `palette-option-${i}`;
          li.setAttribute('role', 'option');
          li.setAttribute('aria-selected', String(i === active));
          const a = document.createElement('a');
          a.href = item.url;
          a.tabIndex = -1;
          const title = document.createElement('span');
          title.textContent = item.title;
          const kind = document.createElement('span');
          kind.className = 'meta';
          kind.textContent = item.kind;
          a.append(title, kind);
          li.append(a);
          li.addEventListener('pointermove', () => {
            if (active !== i) setActive(i);
          });
          return li;
        }),
      );
      input.setAttribute('aria-activedescendant', items.length ? `palette-option-${active}` : '');
    };

    const setActive = (i: number) => {
      active = (i + items.length) % items.length;
      paint();
      list.children[active]?.scrollIntoView({ block: 'nearest' });
    };

    const run = async () => {
      const query = input.value.trim();
      full.href = `${full.pathname}${query ? `?q=${encodeURIComponent(query)}` : ''}`;
      if (!query) {
        items = jumps.map((j) => ({ url: j.url, title: j.label, kind: 'Page' }));
      } else {
        const docs = await loadIndex(dialog.dataset.index!);
        if (input.value.trim() !== query) return; // a newer keystroke won
        items = rank(docs, query)
          .slice(0, 8)
          .map((d) => ({ url: d.url, title: d.title, kind: kindLabel(d) }));
      }
      group.textContent = query ? 'Results' : 'Jump to';
      empty.hidden = !query || items.length > 0;
      active = 0;
      paint();
    };

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      void run();
      dialog.showModal();
      input.focus();
      void loadIndex(dialog.dataset.index!); // warm the index while the user types
    };

    input.addEventListener('input', () => void run());
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (items.length) setActive(active + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const item = items[active];
        if (item) location.href = item.url;
      }
    });
    // Clicking the backdrop (the dialog element itself, outside its content box) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    const typing = (el: Element | null) =>
      el instanceof HTMLInputElement ||
      el instanceof HTMLTextAreaElement ||
      el instanceof HTMLSelectElement ||
      (el instanceof HTMLElement && el.isContentEditable);

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      } else if (event.key === '/' && !dialog.open && !typing(document.activeElement)) {
        event.preventDefault();
        open();
      }
    });

    for (const trigger of document.querySelectorAll<HTMLElement>('[data-palette-open]')) {
      trigger.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey) return; // let modified clicks open /search
        event.preventDefault();
        open();
      });
    }
  }
</script>

<style>
  .palette {
    width: min(38rem, calc(100% - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--bevel), var(--shadow-3);
    overflow: hidden;
  }

  .palette[open] {
    display: flex;
    flex-direction: column;
    animation: palette-in var(--dur-ui) var(--ease-out);
  }

  .palette::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(3px);
  }

  @keyframes palette-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.9rem 0.35rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
  }

  input:focus {
    outline: none;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  kbd {
    display: inline-block;
    min-width: 1.4rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    box-shadow: var(--bevel);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: center;
    color: var(--muted);
  }

  .group {
    padding: 0.8rem 1rem 0.35rem;
  }

  ul {
    overflow-y: auto;
    padding: 0 0.5rem 0.5rem;
  }

  ul :global(a) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.6rem 0.65rem;
    border-radius: var(--radius);
    text-decoration: none;
  }

  ul :global([aria-selected='true'] a) {
    background: var(--surface-raised);
    box-shadow: var(--bevel), inset 2px 0 0 var(--accent);
  }

  ul :global(a .meta) {
    flex-shrink: 0;
  }

  .empty {
    padding: 0 1rem 1rem;
    text-transform: none;
    letter-spacing: 0;
  }

  footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--line);
  }

  footer kbd + kbd {
    margin-left: 0.2rem;
  }

  footer span kbd:last-of-type {
    margin-right: 0.35rem;
  }

  footer .link {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0;
  }
</style>
