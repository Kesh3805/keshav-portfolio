---
import { ArrowUpRight } from '@lucide/astro';
import type { Project } from '../lib/content';
import { motionMedia } from '../lib/motion';
import { href } from '../lib/paths';

interface Props {
  project: Project;
  index?: number;
  headingLevel?: 'h2' | 'h3';
  /** Show the rendered motion poster when one exists. */
  preview?: boolean;
}

const { project, index, headingLevel: Heading = 'h3', preview = false } = Astro.props;
const { title, slug, category, description, technologies, motion, tags } = project.data;
const visible = technologies.slice(0, 5);
const hidden = technologies.length - visible.length;
const posters = preview && motion ? motionMedia(motion).filter((v) => v.poster) : [];
---

<article class="card" data-spotlight data-slug={slug} data-tags={tags.join('|')}>
  {
    posters.length > 0 && (
      <div class="poster-frame">
        {posters.map((v) => (
      <img
        class="poster"
        src={v.poster}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        data-variant={posters.length > 1 ? v.theme : undefined}
      />
        ))}
      </div>
    )
  }
  <div class="top">
    <span class="category" data-category={category}>
      {category === 'professional' ? 'Professional' : 'Personal / Open Source'}
    </span>
    {index !== undefined && <span class="meta">{String(index).padStart(2, '0')}</span>}
  </div>

  <Heading class="title">
    <a href={href(`/projects/${slug}`)}>
      <span data-vt-title>{title}</span>
      <ArrowUpRight size={18} aria-hidden="true" class="arrow" />
    </a>
  </Heading>
  <p class="description">{description}</p>

  <ul class="stack" aria-label="Technologies">
    {visible.map((tech) => <li class="tag">{tech}</li>)}
    {hidden > 0 && <li class="tag more">+{hidden}</li>}
  </ul>

  {motion && !posters.length && <span class="meta has-motion">◧ motion diagram</span>}
</article>

<script>
  import { SELECT_EVENT, cardState, type TopologySelection } from '../lib/topology-state';

  // One delegated listener feeds pointer position to whichever card is under the cursor.
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  let frame = 0;
  document.addEventListener(
    'pointermove',
    (event) => {
      if (!fine.matches || frame) return;
      const card = (event.target as Element | null)?.closest<HTMLElement>('[data-spotlight]');
      if (!card) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
        card.style.setProperty('--my', `${event.clientY - rect.top}px`);
      });
    },
    { passive: true },
  );

  // The homepage topology announces a selection; matching cards step forward, the rest recede.
  document.addEventListener(SELECT_EVENT, (event) => {
    const selection = (event as CustomEvent<TopologySelection>).detail;
    for (const card of document.querySelectorAll<HTMLElement>('[data-slug]')) {
      const state = cardState(card.dataset.slug!, selection);
      if (state) card.dataset.topology = state;
      else delete card.dataset.topology;
    }
  });
</script>

<style>
  .card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem 1.4rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--bevel), var(--shadow-1);
    transition:
      border-color var(--dur-ui) var(--ease),
      box-shadow var(--dur-ui) var(--ease),
      opacity var(--dur-ui) var(--ease),
      transform var(--dur-ui) var(--ease-out);
  }

  .card[data-topology='match'] {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
    box-shadow: var(--bevel), var(--glow-accent);
  }

  .card[data-topology='dim'] {
    opacity: 0.5;
  }

  /* Cursor spotlight (fill) and a brighter rim that follows it (border). */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease);
  }

  .card::before {
    z-index: -1;
    background: radial-gradient(
      26rem circle at var(--mx) var(--my),
      var(--spotlight),
      transparent 55%
    );
  }

  .card::after {
    padding: 1px;
    background: radial-gradient(
      22rem circle at var(--mx) var(--my),
      color-mix(in srgb, var(--accent) 55%, transparent),
      transparent 60%
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--line-strong);
      box-shadow: var(--bevel), var(--shadow-3);
      transform: translateY(-3px);
    }

    .card:hover::before,
    .card:hover::after {
      opacity: 1;
    }

    .card:active {
      transform: translateY(-1px) scale(0.995);
      transition-duration: 80ms;
    }

    /* Project signal: one accent tick traces the top edge on hover, then stops. */
    .card:hover .top::after {
      animation: trace var(--dur-system) var(--ease-data) both;
    }

    /* Entry: when a card grid is revealed, each card's edge traces once, on the same beat as
       its place in the stagger, so the group arrives as one sequence (then it is static). */
    :global([data-stagger].is-revealed:not(.reveal-now)) > .card .top::before {
      animation: trace-in var(--dur-system) var(--ease-data) both;
      animation-delay: calc(min(var(--i, 0), var(--reveal-max)) * var(--reveal-step) + 220ms);
    }
  }

  .card:focus-within {
    border-color: var(--line-strong);
  }

  .poster-frame {
    margin: -1.4rem -1.4rem 0.25rem;
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
  }

  .poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .title {
    font-size: 1.3rem;
  }

  .title a {
    text-decoration: none;
  }

  .title :global(.arrow) {
    display: inline-block;
    margin-left: 0.3rem;
    vertical-align: -0.1em;
  }

  /* Whole card is clickable; the heading link stays the single accessible target. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .title a:focus-visible {
    outline: none;
  }

  .card:has(.title a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .arrow {
    color: var(--faint);
    transition:
      color var(--dur-micro) var(--ease),
      transform var(--dur-micro) var(--ease-out);
  }

  .card:hover .arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .description {
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .more {
    color: var(--faint);
  }

  .has-motion {
    font-size: 0.68rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card:active {
      transform: none;
    }

    .card:hover .top::after {
      animation: none;
    }
  }

  /* ::after is the hover trace, ::before the entry trace; separate so neither blocks the other. */
  .top::before,
  .top::after {
    content: '';
    position: absolute;
    left: -1.4rem;
    top: -1.4rem;
    width: calc(100% + 2.8rem);
    height: 1px;
    background: linear-gradient(90deg, transparent 42%, var(--accent) 50%, transparent 58%) 100% 0 / 300% 100%
      no-repeat;
    opacity: 0;
    pointer-events: none;
  }

  .poster-frame + .top::before,
  .poster-frame + .top::after {
    top: -1.15rem;
  }

  /* The same trace under a second name, so the entry pass never blocks a later hover pass. */
  @keyframes trace-in {
    0% {
      opacity: 0;
      background-position: 100% 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: 0 0;
    }
  }

  @keyframes trace {
    0% {
      opacity: 0;
      background-position: 100% 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      background-position: 0 0;
    }
  }
</style>