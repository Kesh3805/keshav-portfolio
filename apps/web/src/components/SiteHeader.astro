---
import { Menu, Search, X } from '@lucide/astro';
import { href } from '../lib/paths';
import { nav, site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (path: string) => current === path || current.startsWith(`${path}/`);
---

<header class="site-header" data-site-header>
  <a class="skip sr-only-focusable" href="#main">Skip to content</a>
  <div class="container-page shell">
  <div class="island">
  <div class="bar">
    <a class="wordmark" href={href('/')}>
      <span class="mark" aria-hidden="true">k/</span>
      <span>{site.name}</span>
    </a>

    <nav class="primary" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={href(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={site.links.github} rel="me noopener">
            GitHub<span class="sr-only"> (external)</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="tools">
      <a class="icon-btn search-btn" href={href('/search')} aria-label="Search" aria-keyshortcuts="Control+K Meta+K /" data-palette-open>
        <Search size={16} aria-hidden="true" />
        <kbd class="search-kbd" aria-hidden="true" data-shortcut>Ctrl K</kbd>
      </a>
      <ThemeToggle />
      <button
        type="button"
        class="icon-btn menu-btn"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <Menu class="menu-open" size={18} aria-hidden="true" />
        <X class="menu-close" size={18} aria-hidden="true" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile" aria-label="Mobile" hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={href(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href={href('/now')}>Now</a></li>
      <li>
        <a href={site.links.github} rel="me noopener">
          GitHub
        </a>
      </li>
    </ul>
  </nav>
  </div>
  </div>
</header>

<script>
  // Show the platform's modifier in the search shortcut hint.
  const mac = /Mac|iPhone|iPad/.test(navigator.platform);
  for (const kbd of document.querySelectorAll('[data-shortcut]')) if (mac) kbd.textContent = '⌘K';

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });

  // The island firms up (denser glass, stronger shadow) once content scrolls beneath it.
  // toggleAttribute is a no-op when the state doesn't change, so this stays cheap per event.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const syncScrolled = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  syncScrolled();
  window.addEventListener('scroll', syncScrolled, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding-top: 0.75rem;
    pointer-events: none;
  }

  /* Fade content out as it passes above and behind the floating island. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -0.75rem;
    z-index: -1;
    background: linear-gradient(180deg, var(--bg) 35%, transparent);
    pointer-events: none;
  }

  .island {
    pointer-events: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-glass);
    backdrop-filter: saturate(1.5) blur(14px);
    box-shadow: var(--bevel), var(--shadow-1);
    transition:
      box-shadow var(--dur-ui) var(--ease),
      border-color var(--dur-ui) var(--ease),
      background-color var(--dur-ui) var(--ease);
  }

  .site-header[data-scrolled] .island {
    border-color: var(--line-strong);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    box-shadow: var(--bevel), var(--shadow-3);
  }

  .skip {
    position: absolute;
    left: 1rem;
    top: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: var(--radius);
    z-index: 30;
    pointer-events: auto;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.25rem;
    padding-inline: 1rem 0.5rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--accent);
  }

  .primary {
    margin-left: auto;
  }

  .primary ul {
    display: flex;
    gap: 0.15rem;
  }

  .primary a,
  .mobile a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--muted);
    transition:
      color var(--dur-micro) var(--ease),
      background-color var(--dur-micro) var(--ease),
      box-shadow var(--dur-micro) var(--ease);
  }

  .primary a {
    font-size: 0.9rem;
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
  }

  .primary a:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--surface-raised) 70%, transparent);
  }

  .mobile a:hover {
    color: var(--text);
  }

  .primary a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-raised);
    box-shadow:
      var(--bevel),
      0 0 0 1px var(--line),
      inset 0 -1px 0 color-mix(in srgb, var(--accent) 70%, transparent);
  }

  .mobile a[aria-current='page'] {
    color: var(--text);
  }

  .mobile a[aria-current='page']::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .tools {
    display: flex;
    gap: 0.4rem;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--surface-raised);
    box-shadow: var(--bevel);
    cursor: pointer;
    transition:
      color var(--dur-micro) var(--ease),
      border-color var(--dur-micro) var(--ease);
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  /* Search opens the command palette; the shortcut hint shows where there is room for it. */
  .search-kbd {
    display: none;
  }

  @media (min-width: 48rem) {
    .search-btn {
      display: inline-flex;
      gap: 0.45rem;
      width: auto;
      padding-inline: 0.6rem 0.4rem;
    }

    .search-btn :global(svg) {
      grid-area: auto;
    }

    .search-kbd {
      display: inline-block;
      padding: 0.05rem 0.35rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      line-height: 1.4;
      color: var(--faint);
    }
  }

  .icon-btn :global(svg) {
    grid-area: 1 / 1;
  }

  .tools :global(.theme-toggle) {
    border-radius: 999px;
    width: 2.15rem;
    height: 2.15rem;
    background: var(--surface-raised);
    box-shadow: var(--bevel);
  }

  .menu-btn[aria-expanded='false'] .menu-close,
  .menu-btn[aria-expanded='true'] .menu-open {
    display: none;
  }

  .mobile {
    border-top: 1px solid var(--line);
  }

  .mobile ul {
    display: grid;
    padding: 0.35rem 1rem 0.75rem;
  }

  .mobile li + li a {
    border-top: 1px solid var(--line);
  }

  .mobile a {
    width: 100%;
    padding: 0.8rem 0.25rem;
    font-size: 1.05rem;
  }

  @media (max-width: 47.99rem) {
    .shell {
      padding-inline: 0.75rem;
    }

    .primary {
      display: none;
    }

    .tools {
      margin-left: auto;
    }
  }

  @media (min-width: 48rem) {
    .menu-btn,
    .mobile {
      display: none;
    }
  }
</style>