---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '../styles/global.css';
import '../styles/motion.css';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import headingFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import ContentScripts from '../components/ContentScripts.astro';
import SearchPalette from '../components/SearchPalette.astro';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { href } from '../lib/paths';

export type Props = SeoProps;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f2ed" media="(prefers-color-scheme: light)" />
    <meta name="generator" content={Astro.generator} />
    <ThemeScript />
    <!-- Body and heading faces: preloaded so a late swap cannot re-wrap text and shift the layout. -->
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <Seo {...Astro.props} />
    <script is:inline>
      // Title morph across pages: the clicked link's title becomes the next page's heading.
      // Inline in <head> because pagereveal can fire before deferred scripts run.
      addEventListener('pageswap', (event) => {
        const url = event.activation?.entry?.url;
        if (!event.viewTransition || !url) return;
        const link = [...document.querySelectorAll('a[href]')].find(
          (a) => a.href === url && a.querySelector('[data-vt-title]'),
        );
        const title = link?.querySelector('[data-vt-title]');
        if (!title) return;
        title.style.viewTransitionName = 'page-title';
        try {
          sessionStorage.setItem('vt-morph', url);
        } catch {
          /* storage blocked: no morph, the page still transitions */
        }
      });
      // M6 — direction: going up the hierarchy (a case study back to its list) reverses the
      // wipe. Transition pseudo-elements belong to the new document, so the class is set here.
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const from = window.navigation?.activation?.from?.url;
        if (!from) return;
        const depth = (u) => new URL(u).pathname.split('/').filter(Boolean).length;
        if (depth(location.href) >= depth(from)) return;
        document.documentElement.classList.add('vt-back');
        event.viewTransition.finished.finally(() => document.documentElement.classList.remove('vt-back'));
      });
      addEventListener('pagereveal', (event) => {
        let target = null;
        try {
          target = sessionStorage.getItem('vt-morph');
          sessionStorage.removeItem('vt-morph');
        } catch {
          /* storage blocked */
        }
        if (!event.viewTransition || target !== location.href) return;
        const heading = document.querySelector('h1[data-vt-title]');
        if (!heading) return;
        document.documentElement.classList.add('vt-morph');
        heading.style.viewTransitionName = 'page-title';
        event.viewTransition.finished.finally(() => (heading.style.viewTransitionName = ''));
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <SearchPalette />
    <ContentScripts />
    <script>
      // Reveals, once per element as it enters the viewport:
      //   [data-reveal]  the block fades up
      //   [data-stagger] its children arrive in order (index set here as --i)
      //   [data-roll]    metric digits roll to their value
      //   [data-diagram] a diagram's edges draw in (M8)
      for (const list of document.querySelectorAll<HTMLElement>('[data-stagger]')) {
        [...list.children].forEach((child, i) => (child as HTMLElement).style.setProperty('--i', String(i)));
      }
      const blocks = document.querySelectorAll('[data-reveal], [data-stagger], [data-roll], [data-diagram]');
      if (blocks.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target;
              el.classList.add(el.hasAttribute('data-roll') ? 'is-rolled' : 'is-revealed');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -6% 0px' },
        );
        blocks.forEach((block) => io.observe(block));
      }

      // Development-only diagnostics; `import.meta.env.DEV` is false in production builds,
      // so this branch and the overlay module are removed entirely.
      if (import.meta.env.DEV) {
        const mode = new URLSearchParams(location.search).get('debug');
        if (mode === 'topology' || mode === 'motion') {
          void import('../scripts/debug-overlay').then((m) => m.mount(mode));
        }
      }
    </script>
  </body>
</html>
