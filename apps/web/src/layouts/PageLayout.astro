---
import SignalTitle from '../components/SignalTitle.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
}

const { title, description, kicker } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container-page page">
    <header>
      <SignalTitle kicker={kicker} text={title} />
      <slot name="lede" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

</style>
