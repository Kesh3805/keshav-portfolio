---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  kicker: string;
}

const { title, description, kicker } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container-page page">
    <header>
      <p class="meta">{kicker}</p>
      <h1>{title}</h1>
      <slot name="lede" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: 2.5rem;
    padding-top: clamp(2rem, 6vw, 4rem);
  }

  h1 {
    margin-top: 0.5rem;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    letter-spacing: -0.035em;
  }
</style>
